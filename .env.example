# Postgres connection string.
# local (docker):  postgres://reef:reef@localhost:5440/reef
# hosted:          paste the Neon / Render / Supabase connection string
DATABASE_URL=

# Resend API key, for the one transactional email Reefy sends: the link that
# confirms a new account's address.
#
# Optional in development — with no key set the server prints the message, link
# included, to stdout instead of sending, so the whole flow is testable without
# a provider. In production its absence is not silent: sending throws, and
# /api/auth/verify/resend answers 503 rather than claiming a send that will
# never happen.
#
# GET /api/health reports `mail: true|false`, which is how to confirm this
# variable actually reached the running process after a deploy.
RESEND_API_KEY=

# Sender address. REQUIRED before launch — the default is not shippable.
#
# Without this, mail goes out as Resend's shared onboarding@resend.dev, which
# Resend allows to deliver ONLY to the address the Resend account was
# registered with. The developer gets verification emails; every real user gets
# nothing, and because confirmation is soft-gated, signup still looks like it
# worked. That is a silent failure, so treat the default as development-only.
#
# It must be a domain verified in Resend (DKIM/SPF records in its DNS). It
# cannot be a gmail.com or other free-provider address: you cannot publish DNS
# records for a domain you do not control, and Gmail's DMARC policy tells
# receivers to reject mail claiming to be from it.
# MAIL_FROM=Reefy <hello@yourdomain.com>

# Absolute base URL used to build the verification link. Falls back to the host
# that served the request, which is correct on a laptop and on a preview
# deploy. Set it in production so links survive moving behind a custom domain.
# PUBLIC_BASE_URL=https://reeffocus-api.onrender.com
